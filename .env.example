# Copy to .env and fill in. Never commit .env.
# Validated at runtime by src/env.ts.

# PostgreSQL (matches the `db` service in docker-compose.yml)
DATABASE_URL=postgres://xuye:xuye@localhost:5432/xuye

# Auth.js — generate with: pnpm dlx auth secret
AUTH_SECRET=
# Optional in development (falls back to AUTH_SECRET). Set a separate random
# 32+ character value in production for visitor-cookie signing and private hashes.
VISITOR_ID_SECRET=
# Public base URL of the site. Optional for `pnpm dev`; REQUIRED in production
# (`pnpm start`, Docker), otherwise sign-in links point at the bind address.
AUTH_URL=

# Email sign-in links. In development, Mailpit (docker compose) catches all mail:
# open http://localhost:8025 to read it.
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=續頁 <no-reply@xuye.localhost>

# Google sign-in (optional; leave both empty to disable)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple sign-in (optional; requires an Apple Developer account)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
