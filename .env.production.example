# Template for .env.production, used by docker-compose.prod.yml. Never commit .env.production.
# startserver.bat creates .env.production on first run with random secrets and copies the Google
# credentials from .env, so usually only CLOUDFLARE_TUNNEL_TOKEN needs to be pasted in.

# Database password (letters and digits only; it is embedded in a connection URL).
POSTGRES_PASSWORD=

# 32+ random characters each, and different from each other and from development.
AUTH_SECRET=
VISITOR_ID_SECRET=

# Public site address (sign-in callbacks and cookies use it).
AUTH_URL=https://xuye.chaoanstudio.com

# Google sign-in. The OAuth client must list https://xuye.chaoanstudio.com/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command token.
# Leave empty to run without the tunnel (local check at http://127.0.0.1:3080 only).
CLOUDFLARE_TUNNEL_TOKEN=

# Local loopback port for checks (3000 stays free for `pnpm dev`).
APP_PORT=3080
